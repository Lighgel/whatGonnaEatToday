page {
  min-height: 100%;
  color: #1c1612;
  background-color: #f4eee6;
  background-image:
    radial-gradient(1200rpx 480rpx at 10% -10%, #ffe8d2 0%, transparent 55%),
    radial-gradient(900rpx 420rpx at 110% 0%, #f3e2c8 0%, transparent 50%);
  font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
}

.page {
  padding: 16rpx 32rpx 160rpx;
}

.brand {
  font-size: 22rpx;
  letter-spacing: 0.22em;
  color: #c45c26;
}

.brand-name {
  margin-top: 4rpx;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: -0.02em;
}

.hero {
  margin-top: 32rpx;
  font-size: 56rpx;
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: -0.03em;
}

.lede {
  margin-top: 16rpx;
  max-width: 92%;
  font-size: 30rpx;
  line-height: 1.6;
  color: #7a6c62;
}

.count {
  margin-top: 24rpx;
  font-size: 88rpx;
  font-weight: 600;
  line-height: 1;
  letter-spacing: -0.04em;
}

.count-label {
  margin-top: 12rpx;
  font-size: 30rpx;
  color: #7a6c62;
}

.sheet {
  margin-top: 48rpx;
  padding: 40rpx;
  border-radius: 56rpx;
  background: #fffcf7;
  box-shadow: 0 24rpx 80rpx rgba(80, 40, 10, 0.08);
}

.sheet-dark {
  background: #1c1612;
  color: #fffcf7;
  box-shadow: none;
}

.sheet-dark .muted {
  color: #d9cbbd;
}

.sheet-white {
  margin-top: 24rpx;
  padding: 40rpx;
  border-radius: 48rpx;
  background: #fff;
  box-shadow: 0 16rpx 60rpx rgba(80, 40, 10, 0.06);
}

.sheet-white.dim {
  opacity: 0.55;
}

.step {
  display: flex;
  align-items: flex-start;
  gap: 28rpx;
}

.num {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  margin-top: 4rpx;
  border-radius: 999rpx;
  background: #1c1612;
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 56rpx;
  text-align: center;
}

.step-body {
  min-width: 0;
  flex: 1;
}

.step-title {
  font-size: 30rpx;
  font-weight: 500;
}

.step-sub {
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #7a6c62;
}

.rule {
  height: 1rpx;
  margin: 40rpx 0;
  background: #ead9c8;
}

.loc-row {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
  margin-top: 24rpx;
}

.loc-row .fb-input {
  margin-top: 0;
}

.loc-input {
  flex: 1;
  min-width: 0;
}

.fb-input {
  display: block;
  width: 100%;
  height: 88rpx;
  margin-top: 24rpx;
  padding: 0 28rpx;
  border: 1rpx solid #ead9c8;
  border-radius: 24rpx;
  background: #fff;
  box-sizing: border-box;
  font-family: "Microsoft YaHei", sans-serif;
  font-size: 30rpx;
  line-height: 88rpx;
  color: #1c1612;
}

.ph {
  color: #a89888;
  font-size: 30rpx;
  line-height: 88rpx;
}

.fb-input.tight {
  margin-top: 8rpx;
}

.locate-btn {
  flex-shrink: 0;
  height: 88rpx;
  padding: 0 28rpx;
  border-radius: 24rpx;
  background: #efe4d6;
  box-sizing: border-box;
  color: #4a3f38;
  font-size: 28rpx;
  line-height: 88rpx;
  text-align: center;
}

.accent {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #c45c26;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.chip {
  height: 64rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #efe4d6;
  box-sizing: border-box;
  color: #4a3f38;
  font-size: 28rpx;
  line-height: 64rpx;
}

.chip.on {
  background: #1c1612;
  color: #fff;
}

.fb-primary {
  display: block;
  width: 100%;
  height: 88rpx;
  margin-top: 32rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  background: #c45c26;
  box-sizing: border-box;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 88rpx;
  text-align: center;
}

.fb-primary.dark {
  background: #1c1612;
}

.fb-primary.off {
  opacity: 0.55;
}

.ghost-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
}

.fb-ghost {
  height: 64rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #efe4d6;
  box-sizing: border-box;
  color: #4a3f38;
  font-size: 26rpx;
  line-height: 64rpx;
}

.more {
  margin-top: 40rpx;
  font-size: 24rpx;
  color: #7a6c62;
}

.filters {
  margin-top: 24rpx;
  padding: 32rpx;
  border-radius: 32rpx;
  background: #f7efe6;
}

.filter-label {
  display: block;
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #7a6c62;
}

.filter-label:first-child {
  margin-top: 0;
}

.note {
  margin-top: 32rpx;
  padding: 32rpx 40rpx;
  border-radius: 48rpx;
  background: #fff;
  box-shadow: 0 8rpx 30rpx rgba(80, 40, 10, 0.04);
  font-size: 28rpx;
  line-height: 1.6;
  color: #7a6c62;
}

.caption {
  margin-top: 32rpx;
  padding: 0 8rpx;
  font-size: 24rpx;
  letter-spacing: 0.04em;
  color: #7a6c62;
}

.index {
  font-size: 24rpx;
  color: #7a6c62;
}

.name {
  margin-top: 8rpx;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.3;
}

.head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.head-main {
  min-width: 0;
  flex: 1;
}

.kicker {
  font-size: 22rpx;
  color: #7a6c62;
}

.line {
  margin-top: 8rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 24rpx;
  color: #7a6c62;
}

.trip {
  flex-shrink: 0;
  max-width: 220rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #fff1e4;
  color: #c45c26;
  font-size: 22rpx;
  line-height: 1.35;
  text-align: right;
}

.meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #7a6c62;
}

.reason {
  margin-top: 16rpx;
  font-size: 30rpx;
  line-height: 1.55;
  color: #4a3f38;
}

.pills {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 32rpx;
}

.pill {
  height: 64rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #efe4d6;
  box-sizing: border-box;
  color: #1c1612;
  font-size: 28rpx;
  line-height: 64rpx;
}

.pill.ink {
  background: #1c1612;
  color: #fff;
}

.error {
  margin-top: 32rpx;
  font-size: 28rpx;
  color: #b91c1c;
}

.map-card {
  margin-top: 24rpx;
  padding: 40rpx;
  border-radius: 48rpx;
  border: 1rpx solid #ead9c8;
  background: #fffaf3;
}

.muted {
  font-size: 24rpx;
  line-height: 1.55;
  color: #7a6c62;
}
