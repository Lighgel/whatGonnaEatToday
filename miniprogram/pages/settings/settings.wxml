<view class="page">
  <view class="brand">FRIDAYBITE</view>

  <view class="sheet">
    <input placeholder-class="ph" class="fb-input" value="{{apiBase}}" bindinput="onBase" placeholder="http://127.0.0.1:3847" />
    <view class="fb-primary" bindtap="save">保存地址</view>
    <view class="fb-ghost" bindtap="ping">测试连接</view>
    <view class="accent" wx:if="{{note}}">{{note}}</view>
    <view class="error" wx:if="{{error}}">{{error}}</view>
  </view>

</view>
